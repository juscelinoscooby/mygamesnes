{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "manifest.webmanifest",
          "manifest.json",
          "sw.js",
          "icon-192.png",
          "icon-512.png",
          "pix-qr.jpeg",
          "games/**",
          "emulator/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
